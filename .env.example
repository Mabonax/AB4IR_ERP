APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ab4irerp
DB_USERNAME=ab4irerp
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
COMPOSE_PROJECT_NAME=ab4irerp
APP_ENV_FILE=.env
APP_RUNTIME_IMAGE=ghcr.io/mabonax/ab4ir_erp-app:latest
WEB_RUNTIME_IMAGE=ghcr.io/mabonax/ab4ir_erp-web:latest
RUN_MIGRATIONS=true
RUN_ACCESS_CONTROL_RESYNC=false
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TIMEOUT=120
QUEUE_WORKER_QUEUES=default
SCHEDULER_INTERVAL=60

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@ab4irerp.local
SUPER_ADMIN_PASSWORD=password
FACILITATOR_USER_DEFAULT_PASSWORD=password
